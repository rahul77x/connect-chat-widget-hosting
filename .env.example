# =============================================================================
# Amazon Connect Chat Widget & IAM Identity Center (IDC) OIDC Configuration (Template)
# (Modeled after amazon-connect/ai-agents-lab-amazon-connect)
# =============================================================================

# --- 1. IAM Identity Center (IDC) OIDC Settings ---
VITE_OIDC_ISSUER_URL=https://oidc.eu-west-1.amazonaws.com
VITE_OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID
VITE_OIDC_CLIENT_SECRET=
VITE_OIDC_REDIRECT_URI=http://localhost:3000
VITE_AWS_REGION=eu-west-1
VITE_OIDC_SCOPES=sso:account:access
VITE_AUTH_BYPASS=false

# --- 2. Amazon Connect Chat Widget Settings ---
CONNECT_SNIPPET_URL=https://YOUR_CONNECT_INSTANCE.my.connect.aws/connectwidget/static/amazon-connect-chat-interface-client.js
CONNECT_SNIPPET_ID=YOUR_CONNECT_SNIPPET_ID
AWS_REGION=eu-west-1

# --- 3. Local Server Port ---
PORT=3000
