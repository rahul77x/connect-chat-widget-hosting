# =============================================================================
# Amazon Connect Chat Widget & OIDC Authentication Configuration (Template)
# Copy this file to .env and fill in your values
# =============================================================================

# --- 1. OIDC Identity Provider Settings ---
# Example Cognito: https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# Example Okta:    https://your-domain.okta.com
VITE_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/YOUR_USER_POOL_ID

# The App Client ID configured in your OIDC provider
VITE_OIDC_CLIENT_ID=YOUR_OIDC_APP_CLIENT_ID

# The redirect URI registered in your OIDC provider callback list
VITE_OIDC_REDIRECT_URI=http://localhost:3000

# Scopes to request
VITE_OIDC_SCOPES=openid email profile

# --- 2. Amazon Connect Chat Widget Settings ---
CONNECT_SNIPPET_URL=https://YOUR_CONNECT_INSTANCE.my.connect.aws/connectwidget/static/amazon-connect-chat-interface-client.js
CONNECT_SNIPPET_ID=YOUR_CONNECT_SNIPPET_ID

AWS_REGION=us-east-1
PORT=3000
